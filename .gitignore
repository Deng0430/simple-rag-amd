# Publish the deployable system only. All other root entries stay local,
# including docs/, experiments/, runs/, results/, tmp/, models/, .cache/,
# virtual environments, personal reports and standalone experiment scripts.
/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/requirements.txt
!/app.py
!/rag.py
!/answer_protocol.py
!/structured_model.py
!/hybrid_retrieval.py
!/hybrid_runtime.py
!/retrievers.py
!/embedding_model.py
!/knowledge.py
!/prepare_knowledge.py
!/start_aup.sh
!/start_local.ps1

# Only public source metadata, UI examples and the runtime project guide.
!/data/
/data/*
!/data/source_manifest.json
!/data/example_questions.json
!/data/project-usage.md
!/data/ATTRIBUTION.md

!/assets/
/assets/*
!/assets/style.css

!/.streamlit/
/.streamlit/*
!/.streamlit/config.toml
!/.vscode/
/.vscode/*
!/.vscode/tasks.json

# Synthetic unit tests for the shipped system; no evaluation sets or scores.
!/tests/
/tests/*
!/tests/test_local_generator.py
!/tests/test_retrievers_knowledge.py
!/tests/test_hybrid_retrieval.py
!/tests/test_hybrid_runtime.py
